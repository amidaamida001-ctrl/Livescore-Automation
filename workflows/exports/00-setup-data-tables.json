    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tables = $input.all().map(item => item.json);\nconst expected = { team_strengths: 12, league_strengths: 7, prediction_log: 47 };\nfor (const [name, count] of Object.entries(expected)) {\n  const table = tables.find(row => row.name === name);\n  if (!table) throw new Error(`Setup did not produce table ${name}.`);\n  if (!Array.isArray(table.columns) || table.columns.length !== count) throw new Error(`Table ${name} has ${table.columns?.length ?? 0} columns; expected ${count}.`);\n}\nreturn [{ json: { setup: 'verified', tables: Object.entries(expected).map(([name, column_count]) => ({ name, column_count })) } }];"
      },
