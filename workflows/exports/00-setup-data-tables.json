    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const existing = $input.all().map(item => item.json).filter(row => typeof row.name === 'string');\nconst expected = {\n  team_strengths: [['team_key','string'],['league_id','number'],['season','number'],['team_id','number'],['team_name','string'],['home_played','number'],['home_goals_for','number'],['home_goals_against','number'],['away_played','number'],['away_goals_for','number'],['away_goals_against','number'],['updated_at','date']],\n  league_strengths: [['league_key','string'],['league_id','number'],['season','number'],['league_home_avg','number'],['league_away_avg','number'],['matches_used','number'],['updated_at','date']],\n  prediction_log: [['prediction_key','string'],['fixture_id','number'],['model_version','string'],['league_id','number'],['league_name','string'],['fixture_season','number'],['strength_season','number'],['match_date','date'],['home_team_id','number'],['home_team_name','string'],['away_team_id','number'],['away_team_name','string'],['lambda_home','number'],['lambda_away','number'],['top_score','string'],['top_scores_json','string'],['home_win_prob','number'],['draw_prob','number'],['away_win_prob','number'],['grid_max_goals','number'],['grid_mass','number'],['residual_prob','number'],['home_team_home_played','number'],['away_team_away_played','number'],['home_attack_strength','number'],['home_defence_weakness','number'],['away_attack_strength','number'],['away_defence_weakness','number'],['league_home_avg','number'],['league_away_avg','number'],['team_strengths_updated_at','date'],['league_strengths_updated_at','date'],['status','string'],['predicted_at','date'],['attempt_count','number'],['last_attempt_at','date'],['sent_at','date'],['telegram_message_id','string'],['error_message','string'],['actual_home_goals','number'],['actual_away_goals','number'],['actual_match_status','string'],['actual_outcome','string'],['actual_score_probability','number'],['brier_1x2','number'],['top3_hit','boolean'],['evaluated_at','date']]\n};\nconst missing = [];\nfor (const [name, columns] of Object.entries(expected)) {\n  const table = existing.find(row => row.name === name);\n  if (!table) { missing.push(name); continue; }\n  const actual = (table.columns || []).map(column => [column.name, column.type]).sort((a,b) => a[0].localeCompare(b[0]));\n  const wanted = columns.map(column => [...column]).sort((a,b) => a[0].localeCompare(b[0]));\n  if (JSON.stringify(actual) !== JSON.stringify(wanted)) {\n    throw new Error(`Existing table ${name} has a different schema. No tables were created; inspect it manually and preserve its rows.`);\n  }\n}\nreturn [{ json: { preflightPassed: true, existingMatchingTables: expected ? Object.keys(expected).filter(name => existing.some(row => row.name === name)) : [], missingTables: missing } }];"
      },
